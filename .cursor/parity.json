{
  "$comment": "Heatshrink C/Rust parity gate. Gate script: ./.cursor/hooks/c-rust-parity/parity_gate.py",
  "build": ["make", "parity-build"],
  "c_cmd": ["./build/oracle", "{input}"],
  "rust_cmd": ["./target/release/heatshrink-driver", "{input}"],
  "input_mode": "arg",
  "fixtures": ["tests/inputs/**/*"],
  "report_dir": "build/parity-gate",
  "oracle_sources": ["*.c", "*.h"],
  "exceptions_file": "PARITY_EXCEPTIONS.md",
  "exceptions_rs": ["*-core/tests/exceptions.rs"],
  "exceptions_test": ["cargo", "test", "-p", "heatshrink-core", "--test", "exceptions", "--target-dir", "target"],
  "per_run_timeout_s": 30,
  "build_timeout_s": 600,
  "compare_stderr": false,
  "hash_exclude": ["build/**", "target/**"],
  "modules": {
    "encoder": {
      "driver_args": ["--sections", "encoder"],
      "ready": true,
      "fixtures": ["tests/inputs/**/*"]
    },
    "decoder": {
      "driver_args": ["--sections", "decoder"],
      "ready": true,
      "fixtures": ["tests/compressed/**/*"]
    }
  }
}
